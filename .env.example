# Google AI Studio key (https://aistudio.google.com/apikey). Keep the project without billing to stay on the free tier.
GEMINI_API_KEY=
# Chat model and bulk-extraction model
LLM_MODEL=gemini-flash-latest
EXTRACT_MODEL=gemini-flash-lite-latest
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# Empty = embedded local Qdrant in data/qdrant (dev). In docker compose: http://qdrant:6333
QDRANT_URL=
# Read-aloud: local Piper voice (default cs_CZ-jirka-medium). Optional Gemini TTS in front (10 requests/day):
# TTS_MODELS=gemini-3.8-flash-tts
# TTS_VOICE=Charon
